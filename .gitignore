# local session helper, not part of the repo
resume.sh

# Kernel packages built on the workshop and scp'd here for installation.
# 33MB of binaries that are rebuildable in 7 minutes from workshop/kbuild.sh --
# and this repo has twice had stray files swept in by `git add -A`.
*.deb

# Site config: which host holds the offsite copy. Local, not part of the repo.
.offsite.conf

# Site config for home-backup.sh -- untracked on purpose.
.home-backup.conf

# Site config for home-backup.sh -- untracked, written by client-setup.sh
.home-backup.conf

# Apple's camera firmware. Kept on the private archive, never here -- this repo
# is public, and republishing Apple's blob is redistribution. It is also why
# upstream ships an extractor rather than the firmware itself.
# See iteration8:~/archive/facetimehd/ and mba-webcam.sh's MBA_FW_CACHE.
firmware.bin
*.bin
